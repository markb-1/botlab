{
  // `npm run build:server`: compiles the server and all of packages/core (incl. the worker entries,
  // which nothing imports statically) to dist/apps/server/src and dist/packages/core/src.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "../..",
    "outDir": "../../dist",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "../../packages/core/src/**/*.ts"]
}
