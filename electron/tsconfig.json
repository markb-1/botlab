{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "../dist-electron",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "declaration": false
  },
  "include": [
    "./**/*.ts",
    "../src/core/**/*.ts",
    "../src/utils/logger.ts",
    "../src/utils/getMyBalance.ts"
  ],
  "exclude": ["node_modules", "../node_modules", "./scripts/templates/**"]
}
