{
    "name": "botlab",
    "version": "2.0.0",
    "main": "dist-electron/electron/main.js",
    "scripts": {
        "electron:rebuild": "npx @electron/rebuild -f -w better-sqlite3",
        "electron:compile": "tsc -p electron/tsconfig.json",
        "electron:dev": "npm run electron:compile && concurrently -k \"cd web/client && npm run dev\" \"wait-on http://localhost:3000 && VITE_DEV_SERVER_URL=http://localhost:3000 npx electron dist-electron/electron/main.js\"",
        "electron:build": "npm run electron:compile && npm run --prefix web/client build && npx electron-builder",
        "electron:preview": "npm run electron:compile && npx electron dist-electron/electron/main.js",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:copy": "vitest run tests/copytrading/",
        "test:utils": "vitest run tests/utils/",
        "test:resilience": "vitest run tests/resilience/",
        "test:electron": "vitest run tests/electron/"
    },
    "keywords": ["polymarket", "binance", "trading-bot", "electron", "prediction-markets", "crypto"],
    "author": "Mark",
    "license": "ISC",
    "type": "commonjs",
    "description": "Desktop app for automated trading on Polymarket and Binance with scriptable bot strategies",
    "devDependencies": {
        "@electron/rebuild": "^4.0.3",
        "@eslint/js": "^9.19.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/json-schema": "^7.0.15",
        "@types/node": "^22.10.10",
        "@types/uuid": "^10.0.0",
        "@types/write-file-atomic": "^4.0.3",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "concurrently": "^9.2.1",
        "electron": "^40.6.0",
        "electron-builder": "^26.8.1",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "fast-check": "^4.10.2",
        "globals": "^15.14.0",
        "prettier": "^3.4.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.23.0",
        "vitest": "^3.2.4",
        "wait-on": "^9.0.4"
    },
    "dependencies": {
        "@polymarket/clob-client": "^4.14.0",
        "axios": "^1.7.9",
        "better-sqlite3": "^12.6.2",
        "chalk": "^5.4.1",
        "chokidar": "^4.0.3",
        "dotenv": "^16.4.7",
        "esbuild": "^0.27.3",
        "ethers": "^5.8.0",
        "moment": "^2.30.1",
        "uuid": "^13.0.0",
        "write-file-atomic": "^7.0.1",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    }
}
