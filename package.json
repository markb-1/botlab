{
    "name": "botlab",
    "version": "3.0.0-dev",
    "scripts": {
        "preinstall": "node scripts/check-node.mjs",
        "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
        "dev:server": "node --watch --watch-preserve-output --import tsx apps/server/src/main.ts",
        "dev:web": "vite --config apps/web/vite.config.mts",
        "build": "npm run clean && npm run build:server && npm run build:web",
        "build:server": "tsc -p apps/server/tsconfig.build.json",
        "build:web": "vite build --config apps/web/vite.config.mts",
        "clean": "rimraf dist apps/web/dist",
        "start": "node dist/apps/server/src/main.js --production",
        "cli": "tsx apps/server/src/cli.ts",
        "migrate-key": "tsx apps/server/src/cli.ts migrate-key",
        "service:install": "node scripts/service.mjs install",
        "service:uninstall": "node scripts/service.mjs uninstall",
        "typecheck": "npm run typecheck:core && npm run typecheck:server && npm run typecheck:web",
        "typecheck:core": "tsc -p packages/core/tsconfig.json --noEmit",
        "typecheck:server": "tsc -p apps/server/tsconfig.json --noEmit",
        "typecheck:web": "tsc -p apps/web/tsconfig.app.json --noEmit && tsc -p apps/web/tsconfig.node.json --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:copy": "vitest run tests/copytrading/",
        "test:utils": "vitest run tests/utils/",
        "test:resilience": "vitest run tests/resilience/",
        "test:server": "vitest run tests/server/"
    },
    "keywords": [
        "polymarket",
        "binance",
        "trading-bot",
        "prediction-markets",
        "crypto"
    ],
    "author": "Mark",
    "license": "ISC",
    "type": "commonjs",
    "description": "Self-hosted trading lab for Polymarket and Binance: Node server + browser UI, scriptable bots under a server-side risk engine",
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@monaco-editor/react": "^4.7.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/react-query": "^5.105.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/json-schema": "^7.0.15",
        "@types/node": "^22.10.10",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/uuid": "^10.0.0",
        "@types/write-file-atomic": "^4.0.3",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "@vitejs/plugin-react": "^5.2.0",
        "autoprefixer": "^10.6.2",
        "concurrently": "^9.2.1",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.4.26",
        "fast-check": "^4.10.2",
        "globals": "^15.14.0",
        "postcss": "^8.5.32",
        "prettier": "^3.4.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5",
        "rimraf": "^6.1.3",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.23.0",
        "vite": "^7.3.7",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "@polymarket/clob-client": "^4.14.0",
        "axios": "^1.7.9",
        "better-sqlite3": "^12.6.2",
        "chalk": "^5.4.1",
        "chokidar": "^4.0.3",
        "dotenv": "^16.4.7",
        "esbuild": "^0.27.3",
        "ethers": "^5.8.0",
        "hono": "^4.13.14",
        "moment": "^2.30.1",
        "uuid": "^13.0.0",
        "write-file-atomic": "^7.0.1",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "overrides": {
        "@polymarket/clob-client": {
            "axios": "$axios"
        },
        "@ethersproject/providers": {
            "ws": "^8.22.1"
        },
        "monaco-editor": {
            "dompurify": "^3.4.17"
        }
    },
    "engines": {
        "node": ">=22.12 <25"
    }
}
