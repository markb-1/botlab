{
    // Not a build config. Typecheck with `npm run typecheck` (packages/core/tsconfig.json and
    // electron/tsconfig.json). This file only gives vitest's esbuild transform its settings for
    // files under tests/ (nearest tsconfig), so the options below are kept as they were.
    "compilerOptions": {
        "target": "es2016",
        "module": "commonjs",
        "types": ["node"],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "files": []
}
